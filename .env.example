# Every variable the service reads. Copy to .env. Values here are examples only.
NODE_ENV=development
PORT=3000
SISSI_BASE_URL=http://localhost:3000
SISSI_PUBLIC_PATH=/signage
SISSI_CANVA_APP_ID=
SISSI_CANVA_ALLOWED_BRANDS=
SISSI_PUSH_KEY=
SISSI_CORS_ORIGINS=
SISSI_DOWNLOAD_HOSTS=canva.com,canva.dev,canva-apps.com
SISSI_ADMIN_PASSWORD=
# Tunnus sign-in (docs/tunnus-sign-in.md). legacy (default) | both | tunnus
SISSI_AUTH_MODE=legacy
SISSI_TUNNUS_ISSUER=
# The name Sissi must find in the token's aud (the resource URI the Tunnus client is allowed to request)
SISSI_TUNNUS_AUDIENCE=
SISSI_TUNNUS_JWKS_URL=
# group=sissi:write,sissi:operate;group2=sissi:write  (real group names live in the private deploy repo)
SISSI_TUNNUS_GROUP_RIGHTS=
METRICS_BEARER_TOKEN=
SISSI_STORAGE=local
SISSI_LOCAL_DIR=./data
SISSI_S3_ENDPOINT=
SISSI_S3_REGION=us-east-1
SISSI_S3_BUCKET=
SISSI_S3_ACCESS_KEY_ID=
SISSI_S3_SECRET_ACCESS_KEY=
SISSI_S3_FORCE_PATH_STYLE=1
SISSI_S3_PREFIX=
SISSI_MAX_IMAGE_MB=40
SISSI_MAX_VIDEO_MB=500
SISSI_MAX_PUSH_MB=1024
SISSI_MAX_BODY_KB=256
SISSI_MAX_CONCURRENT_PUSHES=3
SISSI_SW_MAX_VIDEO_MB=100
SISSI_GC_GRACE_MINUTES=60
SISSI_PUSH_RETENTION_HOURS=24
# Tests only; refused when NODE_ENV=production
SISSI_ALLOW_PRIVATE_DOWNLOADS=0
