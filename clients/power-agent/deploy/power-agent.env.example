# Base URL of the SiSSi server (no trailing slash)
SISSI_URL=https://example.org/signage

# Bearer token configured in SiSSi SISSI_AGENT_TOKENS for this LAN
SISSI_AGENT_TOKEN=replace-with-agent-token

# Directory where Samsung pairing tokens (tokens.json) are stored
SISSI_POWER_DATA_DIR=/var/lib/sissi-power-agent

# Poll interval in seconds (default 60)
SISSI_POLL_SECONDS=60

# Optional comma-separated UDP broadcast address(es) for Wake-on-LAN
SISSI_WOL_BROADCAST=255.255.255.255
